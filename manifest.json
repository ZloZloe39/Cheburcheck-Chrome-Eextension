{
  "manifest_version": 3,
  "name": "Cheburcheck — проверка блокировок",
  "version": "1.0.0",
  "description": "Проверка сайтов на блокировку (Роскомнадзор и заблокированные CDN) через cheburcheck.ru: правый клик по ссылке → «Проверить блокировку».",
  "permissions": ["contextMenus", "notifications", "storage"],
  "host_permissions": ["https://cheburcheck.ru/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cheburcheck — последние проверки",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
